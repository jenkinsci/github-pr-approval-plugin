<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">
    <td class="jenkins-table__cell--tight" style="text-align: center;">
        <j:if test="${it.isPendingApproval(job)}">
            <a href="${rootURL}/${job.url}pendingApproval" title="Pending external approval">
                <l:icon src="symbol-warning plugin-ionicons-api" class="icon-md"/>
            </a>
        </j:if>
    </td>
</j:jelly>
